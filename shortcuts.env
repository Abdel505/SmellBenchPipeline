# Shell shortcuts for testing the pipeline on SUT commits (Git Bash).
# Loaded automatically by sut.env; needs SUT_GIT_DIR, so source sut.env, not this file directly.

# Shortcut: go <hash>  → sets C, checks out that SUT commit, prints it.
go() { C=$1; git -C "$SUT_GIT_DIR" checkout --detach "$C" && git -C "$SUT_GIT_DIR" log --oneline -1; }

# Shortcut: commits [N]  → last N (default 5) upstream commits touching byte-buddy-dep Java sources.
# Uses master, not HEAD, so the list stays the same whichever commit you are on.
commits() { git -C "$SUT_GIT_DIR" log --oneline -"${1:-5}" master -- byte-buddy-dep/src/main/java; }

# Shortcut: latest  → back to the newest upstream commit (master); updates C to match.
latest() { git -C "$SUT_GIT_DIR" checkout master && C=$(git -C "$SUT_GIT_DIR" rev-parse --short HEAD) && git -C "$SUT_GIT_DIR" log --oneline -1; }
