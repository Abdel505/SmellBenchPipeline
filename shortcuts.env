# Shell shortcuts for testing the pipeline on SUT commits (Git Bash).
# Loaded automatically by sut.env; needs SUT_GIT_DIR, so source sut.env, not this file directly.

# Shortcut: go <hash>  → sets C, checks out that SUT commit, prints it.
go() { C=$1; git -C "$SUT_GIT_DIR" checkout --detach "$C" && git -C "$SUT_GIT_DIR" log --oneline -1; }

# Shortcut: commits [N]  → last N (default 5) upstream commits touching byte-buddy-dep Java sources.
# Uses master, not HEAD, so the list stays the same whichever commit you are on.
commits() { git -C "$SUT_GIT_DIR" log --oneline -"${1:-5}" master -- byte-buddy-dep/src/main/java; }

# Shortcut: latest  → back to the newest upstream commit (master); updates C to match.
latest() { git -C "$SUT_GIT_DIR" checkout master && C=$(git -C "$SUT_GIT_DIR" rev-parse --short HEAD) && git -C "$SUT_GIT_DIR" log --oneline -1; }

# Pipeline root (this file's folder), so the shortcuts below work from any directory.
PIPELINE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Pipeline shortcuts, in pipeline order. Each runs in the pipeline root (so file paths
# are relative to it), passes all args through, and accepts -h / --help.
# Env prefixes work too, e.g.  RUN_AMBER=0 runbench <regex>
_pipe() { (cd "$PIPELINE_ROOT" && "$@"); }
detect()   { _pipe bash scripts/detect_changed_methods.sh "$@"; }
collect()  { _pipe bash scripts/collect_applicability_targets.sh "$@"; }
smells()   { _pipe python smell-checker/smell_applicability_checker.py "$@"; }
filter()   { _pipe bash scripts/filter_methods_2.sh "$@"; }
matrix()   { _pipe bash scripts/update_coverage_matrix.sh "$@"; }
genbench() { _pipe bash scripts/generate_benchmark.sh "$@"; }
validate() { _pipe bash scripts/validate_benchmark.sh "$@"; }
lookup()   { _pipe bash scripts/lookup_benchmark.sh "$@"; }
runbench() { _pipe bash scripts/run-benchmarks.sh "$@"; }

# Shortcut: pipehelp  → list every shortcut; pipehelp <name> = <name> -h
pipehelp() {
  if [[ -n "${1:-}" ]]; then "$1" -h; return; fi
  cat <<'EOF'
SUT:       go <hash> | commits [N] | latest
Pipeline:  detect -> collect -> smells -> filter -> matrix -> runbench
Tools:     genbench <file> <method> | validate <bench> <method> | lookup <fqn>
Help:      <shortcut> -h   or   pipehelp <shortcut>
EOF
}
